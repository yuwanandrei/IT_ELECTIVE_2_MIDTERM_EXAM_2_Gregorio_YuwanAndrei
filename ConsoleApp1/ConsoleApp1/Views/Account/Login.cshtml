@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-wrap my-4">
    <div class="auth-side">
        <div>
            <span class="section-eyebrow" style="color:#BFF3EC">Welcome back</span>
            <h2 class="mt-2">Sign in to the monitoring list</h2>
            <p>Pick up right where the front desk left off — see who's waiting, who's in with a physician, and who's ready to be marked complete.</p>
        </div>
        <div class="pulse-line">
            <svg viewBox="0 0 400 20" preserveAspectRatio="none">
                <path d="M0 10 H150 L164 10 L174 2 L184 18 L194 10 H400" />
            </svg>
        </div>
        <p class="mb-0" style="font-size:.85rem;">New here? <a asp-controller="Account" asp-action="Register" class="text-white text-decoration-underline">Create an account</a></p>
    </div>
    <div class="auth-form-pane">
        <div class="card w-100">
            <div class="card-body">
                <span class="section-eyebrow">Account access</span>
                <h3 class="card-title mt-2 mb-4">Login</h3>
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-2"></i>Login</button>
                </form>
                <p class="mt-3 mb-0">Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
