@model PatientVisit
@{
    ViewData["Title"] = "Edit Patient Visit";
}
<div class="mt-4 mb-4">
    <span class="section-eyebrow">Update record</span>
    <h3 class="mt-1">Edit Patient Visit &mdash; <span class="visit-tag">@Model.VisitNumber</span></h3>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <fieldset class="form-section">
                <legend><i class="bi bi-person-vcard"></i>Patient details</legend>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" class="form-control" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Sex" class="form-label"></label>
                        <select asp-for="Sex" class="form-select" asp-items="Html.GetEnumSelectList<Sex>()"></select>
                        <span asp-validation-for="Sex" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactNumber" class="form-label"></label>
                        <input asp-for="ContactNumber" class="form-control" />
                        <span asp-validation-for="ContactNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-1">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend><i class="bi bi-clipboard2-pulse"></i>Visit details</legend>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Physician" class="form-label"></label>
                        <input asp-for="Physician" class="form-control" />
                        <span asp-validation-for="Physician" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="VisitType" class="form-label"></label>
                        <select asp-for="VisitType" class="form-select" asp-items="Html.GetEnumSelectList<VisitType>()"></select>
                        <span asp-validation-for="VisitType" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ArrivalDateTime" class="form-label"></label>
                        <input asp-for="ArrivalDateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="ArrivalDateTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="ChiefComplaint" class="form-label"></label>
                    <textarea asp-for="ChiefComplaint" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="ChiefComplaint" class="text-danger"></span>
                </div>
                <div class="mb-1">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </fieldset>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
