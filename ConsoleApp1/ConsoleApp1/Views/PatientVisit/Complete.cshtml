@model PatientVisit
@{
    ViewData["Title"] = "Complete Consultation";
}
<h3 class="mb-4">Complete Consultation</h3>
<div class="card">
    <div class="card-body">
        <p>Mark the consultation for <strong>@Model.FullName</strong> (Visit @Model.VisitNumber) with physician <strong>@Model.Physician</strong> as completed?</p>
        <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Confirm Completion</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
