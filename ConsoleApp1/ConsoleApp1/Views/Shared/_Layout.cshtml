<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Clinic Patient Visit Monitoring</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md clinic-nav sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 12h4l1.6-4 3 8L13 9l1.8 3H22" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span>Clinic Visit<br class="d-none d-lg-block" /> Monitoring</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-md-center gap-md-1">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PatientVisit" asp-action="Index"><i class="bi bi-clipboard2-pulse me-1"></i>Monitoring List</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-nav-cta" asp-controller="PatientVisit" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Register Visit</a>
                        </li>
                        <li class="nav-item ms-md-2">
                            <span class="user-chip">
                                <span class="avatar-sm">@(User.Identity.Name != null && User.Identity.Name.Length > 0 ? User.Identity.Name.Substring(0,1).ToUpper() : "?")</span>
                                @User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex ms-md-2 mt-2 mt-md-0">
                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-nav-cta" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="pulse-line" aria-hidden="true">
        <svg viewBox="0 0 1200 20" preserveAspectRatio="none">
            <path d="M0 10 H480 L500 10 L512 2 L524 18 L536 10 H1200" />
        </svg>
    </div>
    <div class="container page-wrap">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
        }
        @RenderBody()
    </div>
    <footer class="clinic-footer">
        <div class="container">
            Clinic Visit Monitoring &middot; internal patient flow tool
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
