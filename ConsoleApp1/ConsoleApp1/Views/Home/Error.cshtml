@{
    ViewData["Title"] = "Error";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card text-center">
            <div class="card-body py-5">
                <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center"
                     style="width:60px;height:60px;border-radius:16px;background:var(--coral-100);color:#C64A34;font-size:1.6rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h3 class="card-title">Something went wrong</h3>
                <p class="mb-4" style="color: var(--ink-500);">An error occurred while processing your request.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-2"></i>Back to Home</a>
            </div>
        </div>
    </div>
</div>
